# AI 분석 공급자: openai | mock (키가 없으면 자동으로 mock)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# 구간 분석용(많이 부름, 저렴한 모델)과 종합용(한 번, 좋은 모델). 대시보드의 모델 목록에서 고르세요.
OPENAI_CHUNK_MODEL=gpt-4.1-mini
OPENAI_SYNTH_MODEL=gpt-4.1

# Supabase (공유 링크 저장용). 서버에서만 쓰므로 NEXT_PUBLIC 접두사를 붙이지 않는다.
SUPABASE_URL=
# Project Settings > API Keys 의 secret key(sb_secret_...) 또는 예전 service_role 키
SUPABASE_SECRET_KEY=

# Vercel Cron(/api/cron/ping) 인증용 임의 문자열. Vercel이 Authorization: Bearer 헤더로 보낸다.
CRON_SECRET=

# 반박 투표 실시간 반영(Realtime Broadcast 수신 전용). publishable 키는 브라우저에 공개돼도 되는 키.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 토스페이 직접 계약 API Key (서버 전용). sk_test_ 테스트, sk_live_ 실거래
TOSSPAY_API_KEY=
# 1이면 AI 분석에 이용권 필수 (실거래 키 받은 뒤 켜기)
NEXT_PUBLIC_PAYMENT_REQUIRED=
