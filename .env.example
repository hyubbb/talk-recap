# AI 분석 공급자: openai | mock (키가 없으면 자동으로 mock)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# 구간 분석용(많이 부름, 저렴한 모델)과 종합용(한 번, 좋은 모델). 대시보드의 모델 목록에서 고르세요.
OPENAI_CHUNK_MODEL=gpt-4.1-mini
OPENAI_SYNTH_MODEL=gpt-4.1

# Supabase (공유 링크 저장용). 서버에서만 쓰므로 NEXT_PUBLIC 접두사를 붙이지 않는다.
SUPABASE_URL=
# Project Settings > API Keys 의 secret key(sb_secret_...) 또는 예전 service_role 키
SUPABASE_SECRET_KEY=
